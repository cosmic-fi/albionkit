{
  "crons": [
    {
      "path": "/api/cron/check-gold",
      "schedule": "0 */12 * * *"
    },
    {
      "path": "/api/cron/check-flips",
      "schedule": "0 12 * * 1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
